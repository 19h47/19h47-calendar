{
	"name": "@19h47/calendar",
	"version": "2.0.0",
	"description": "Calendar",
	"main": "dist/calendar.js",
	"module": "dist/calendar.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/calendar.js",
			"require": "./dist/calendar.umd.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"release": "pnpm login && pnpm run build && pnpm publish",
		"dev": "vite",
		"build": "vite build",
		"docs": "pnpm run build && cp dist/calendar.js docs/calendar.js && sed \"s|from './lib/index.ts'|from './calendar.js'|\" index.html > docs/index.html"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/19h47/19h47-calendar.git"
	},
	"author": "Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/19h47/19h47-calendar/issues"
	},
	"homepage": "https://github.com/19h47/19h47-calendar#readme",
	"devDependencies": {
		"typescript": "^5.8.3",
		"vite": "^7.0.5",
		"vite-plugin-dts": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
